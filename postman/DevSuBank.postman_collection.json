      "name": "4. Reportes",
      "item": [
        {
          "name": "F4 - Estado de cuenta por cliente y rango de fechas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{servidor}}:{{puerto}}/api/v1/reportes?fechaInicial={{fechaInicial}}&fechaFinal={{fechaFinal}}&cliente={{marianelaId}}",
              "host": [
                "{{servidor}}"
              ],
              "port": "{{puerto}}",
              "path": [
                "api",
                "v1",
                "reportes"
              ],
              "query": [
                {
                  "key": "fechaInicial",
                  "value": "{{fechaInicial}}"
                },
                {
                  "key": "fechaFinal",
                  "value": "{{fechaFinal}}"
                },
                {
                  "key": "cliente",
                  "value": "{{marianelaId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date().toISOString().split(\"T\")[0];",
                  "pm.collectionVariables.set(\"fechaInicial\", hoy);",
                  "pm.collectionVariables.set(\"fechaFinal\", hoy);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "const filas = pm.response.json();",
                  "pm.test(\"Devuelve movimientos del cliente\", () => pm.expect(filas).to.have.lengthOf.at.least(2));",
                  "pm.test(\"Trae los campos del enunciado\", () => {",
                  "    const campos = [\"Fecha\", \"Cliente\", \"Numero Cuenta\", \"Tipo\", \"Saldo Inicial\", \"Estado\", \"Movimiento\", \"Saldo Disponible\"];",
                  "    campos.forEach(campo => pm.expect(filas[0]).to.have.property(campo));",
                  "});",
                  "pm.test(\"El tipo de cuenta viene descrito\", () => pm.expect([\"Ahorros\", \"Corriente\"]).to.include(filas[0].Tipo));"
                ]
              }
            }
          ]
        },
